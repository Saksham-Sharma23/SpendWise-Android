dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` — never hand-edited,
# never committed. Editing them directly is how a CNG project rots.
/android
/ios

# Local native modules ARE committed (modules/*/android is hand-written);
# only Gradle's output inside them is not.
modules/*/android/build/
modules/*/android/.cxx/

*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

npm-debug.*
yarn-error.*

.DS_Store
*.log

# Local database pulled off the device for inspection (db:pull).
# Real financial data — must never be committed.
local.db
*.db-wal
*.db-shm

.env
.env.local
gradle-build.log
gradle-release.log
prebuild.log
