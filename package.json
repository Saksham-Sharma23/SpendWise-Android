{
  "name": "spendwise-android",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "node scripts/with-dev-network.js expo run:android --device",
    "prebuild": "expo prebuild --platform android",
    "prebuild:dev": "node scripts/with-dev-network.js expo prebuild --platform android",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "theme:css": "node scripts/gen-theme-css.ts",
    "lint": "eslint . --ignore-pattern \"lint-fixtures/**\" --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "db:pull": "adb exec-out run-as com.spendwise.android cat files/SQLite/spendwise.db > ./local.db",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "android:local": "node scripts/with-dev-network.js expo run:android --device -- -PreactNativeArchitectures=arm64-v8a -Pkotlin.compiler.execution.strategy=in-process --max-workers=2",
    "build:local-apk": "cd android && .\\gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a -Pkotlin.compiler.execution.strategy=in-process --max-workers=2",
    "verify:apk": "bash scripts/verify-apk.sh",
    "build:release-apk": "cd android && .\\gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a -Pkotlin.compiler.execution.strategy=in-process --max-workers=2 && cd .. && bash scripts/verify-apk.sh",
    "lint:selftest": "node scripts/lint-selftest.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release-policy": "node scripts/check-release-policy.js",
    "verify": "npm run typecheck && npm run lint && npm run lint:selftest && npm run format:check && jest && npm run check:release-policy"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@shopify/flash-list": "2.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^1.44.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.27.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^57.0.11",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.7",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}
